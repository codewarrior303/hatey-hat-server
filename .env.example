# ---- Server ----
PORT=5000
NODE_ENV=development

# ---- MongoDB (same database as Better Auth on the client) ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=hatey-hat

# ---- CORS ----
# Comma-separated list of allowed browser origins (no trailing slash).
CLIENT_URL=http://localhost:3000

# ---- JWT verification (tokens issued by Better Auth's jwt plugin) ----
# Base URL of the Next.js app that runs Better Auth. Defaults to the first CLIENT_URL.
AUTH_URL=http://localhost:3000
# Optional overrides. Defaults: JWKS_URL=<AUTH_URL>/api/auth/jwks, issuer/audience=<AUTH_URL>
# JWKS_URL=http://localhost:3000/api/auth/jwks
# JWT_ISSUER=http://localhost:3000
# JWT_AUDIENCE=http://localhost:3000
